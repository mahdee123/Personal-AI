# Base URL of the local Ollama server (no trailing slash).
OLLAMA_BASE_URL=http://localhost:11434

# Default model used by Mahdee AI.
OLLAMA_MODEL=qwen3:8b

# Absolute backstop for a single request (connect + full generation). Rarely
# fires in practice — OLLAMA_IDLE_TIMEOUT_MS below is the primary guard.
OLLAMA_TIMEOUT_MS=600000

# How long a streaming reply may go with no new data before it's considered
# stuck and aborted. Resets on every chunk received — a slow-but-active CPU
# reply (vision analysis, deep thinking) is never killed by this.
OLLAMA_IDLE_TIMEOUT_MS=90000

# How long Ollama keeps the model in memory after a request. Keeping it
# resident avoids paying the (slow) load time again after an idle pause.
OLLAMA_KEEP_ALIVE=30m
