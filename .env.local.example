# Base URL of the local Ollama server (no trailing slash).
OLLAMA_BASE_URL=http://localhost:11434

# Default model used by Mahdee AI.
OLLAMA_MODEL=qwen3:8b

# Max time (ms) to wait for a single completion before giving up.
OLLAMA_TIMEOUT_MS=180000

# How long Ollama keeps the model in memory after a request. Keeping it
# resident avoids paying the (slow) load time again after an idle pause.
OLLAMA_KEEP_ALIVE=30m
